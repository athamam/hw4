# Campus Customs — environment variables.
# Copy this file to `.env` (in this hw4/ folder) and fill in your real key.
# Never commit the real .env.

# Required: your Portkey API key (used to reach gpt-5.6-luna via the Portkey gateway).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: override the Portkey gateway URL (defaults to the one below).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: set a long random string so login sessions survive a server restart.
# If unset, a random secret is generated per process (sessions reset on restart).
# CC_JWT_SECRET=set-a-long-random-string-here
